# Builds use the public address in wrangler.jsonc (vars.SITE_URL).
# Optional override (https origin, no path/query/fragment):
# SITE_URL=https://budget.your-city.gov/
# Set to true for any preview build that should not be indexed.
SEO_NOINDEX=false

# Sign-in. Keep real values in .env.local (Vite) and .dev.vars (Wrangler);
# in Cloudflare they are encrypted Pages secrets (npm run setup sets the
# session secret). The session secret is required: 32+ random characters.
REVIEWER_SESSION_SECRET=
# Optional shared reviewer account for previewing the site before it opens.
REVIEWER_USERNAME=reviewer
REVIEWER_PASSWORD=

# Optional temporary dashboard recovery administrator. Normal staff accounts
# are stored in DASHBOARD_DB. Leave these unset during ordinary operation;
# if needed for recovery, use a long random password and remove after recovery.
ADMIN_EMAIL=
ADMIN_PASSWORD=
